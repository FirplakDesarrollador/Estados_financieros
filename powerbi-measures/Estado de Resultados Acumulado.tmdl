table 'Estado de Resultados Acumulado'
	lineageTag: 3538800f-a3ee-4433-a707-83f6988cab9d

	measure 'Acum Provision Impuesto de Renta' = ```
			CALCULATE([Provisión Impuesto de Renta],
			                            FILTER(ALLSELECTED(Calendario), Calendario[Date] <= MAX(Calendario[Date])))


			```
		lineageTag: bc3e013c-2ad8-47d9-9e4b-5895d18ff05b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

